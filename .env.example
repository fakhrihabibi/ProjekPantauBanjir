# Supabase PostgreSQL (Prisma)
# Pooled connection (PgBouncer) for runtime queries
DATABASE_URL="postgresql://postgres.<YOUR_PROJECT_REF>:<YOUR_DB_PASSWORD>@aws-0-<YOUR_REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Direct connection for prisma db push / migrate / introspect
DIRECT_URL="postgresql://postgres.<YOUR_PROJECT_REF>:<YOUR_DB_PASSWORD>@db.<YOUR_PROJECT_REF>.supabase.co:5432/postgres?sslmode=require"

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Admin authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_dengan_password_kuat
ADMIN_SESSION_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter

# AI - Tanya AI (prioritas: Gemini lalu OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# External APIs (opsional)
BMKG_API_KEY=your_bmkg_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Leaflet Configuration (opsional)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# App Settings
NEXT_PUBLIC_APP_NAME=Sistem Informasi Pemetaan Titik Rawan Banjir
NEXT_PUBLIC_APP_LOCATION=Bojongsoang

# Environment
NODE_ENV=development
